{
  "expo": {
    "name": "Challo",
    "slug": "challo-rider",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E5A915"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyAcJpazQWf4j468g9DnxMsJZzjW0Yp0iSM"
      }
    },
    "android": {
      "userInterfaceStyle": "light",
      "edgeToEdgeEnabled": false,
      "package": "com.rideandhra.rider",
      "googleServicesFile": "./src/google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6ECD9"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcJpazQWf4j468g9DnxMsJZzjW0Yp0iSM"
        }
      },
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3b73beac-3fa3-46c1-bf9e-62bbde367c80"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/bell_icon.png",
          "color": "#E5A915",
          "defaultChannel": "default"
        }
      ]
    ],
    "owner": "mpaulpears"
  }
}
